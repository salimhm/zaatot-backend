{
  "name": "zaatot-backend",
  "module": "src/app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write \"{src,rule}/**/*.ts\"",
    "format:check": "prettier --check \"{src,rule}/**/*.ts\"",
    "typecheck": "bun x tsc --noEmit",
    "rules": "bun rule/index.rule.ts",
    "test": "bun test src",
    "eden": "mkdir -p public && bun tsc -p eden.types.json && cp dist/types/app.d.ts public/eden.ts",
    "all": "bun run format && bun run typecheck && bun run rules && bun run test && bun run eden",
    "dev": "bun run --env-file=.env --watch src/app.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile bin src/app.ts",
    "start": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile bin src/app.ts && ./bin",
    "ai:dev": "bun run --env-file=.env --watch src/ai/server.ai.ts"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "drizzle-kit": "^0.31.10"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/groq": "3.0.29",
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@libsql/client": "^0.17.3",
    "@tursodatabase/api": "^1.9.2",
    "@voltagent/core": "^2.7.7",
    "@voltagent/libsql": "^2.1.2",
    "@voltagent/server-elysia": "^2.0.9",
    "ai": "^6.0.199",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "zod": "^4.4.3"
  }
}
